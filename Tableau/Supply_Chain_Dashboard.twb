      <aliases enabled='yes' />
      <column caption='Total Order' datatype='integer' name='[Calculation_2039249443921920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Terlambat %' datatype='real' name='[Calculation_2039249444839425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([late])' />
      </column>
      <column caption='Terlambat Tanpa Batal %' datatype='real' name='[Calculation_2039249444954115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_status] &lt;&gt; &quot;Shipping canceled&quot; THEN [late] END) / SUM(IF [delivery_status] &lt;&gt; &quot;Shipping canceled&quot; THEN 1 END)' />
      </column>
      <column caption='Rata Keterlambatan' datatype='real' name='[Calculation_2039249445040132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [late] = 1 THEN [gap] END)' />
      </column>
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_2039249445117957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit (supply_chain_item.csv)])/SUM([net_sales (supply_chain_item.csv)])' />
      </column>
      <column caption='Terlambat Jika Jadwal Diubah %' datatype='real' name='[Calculation_2039249447096328]' role='measure' type='quantitative'>
